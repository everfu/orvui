{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@orvui/vue": [
        "packages/vue/src/index.ts"
      ],
      "@orvui/vue/*": [
        "packages/vue/src/*"
      ]
    }
  },
  "include": [
    "packages/vue/src/**/*.ts",
    "packages/vue/src/**/*.vue",
    "tools/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist"
  ]
}
