{
  "name": "orvui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm metadata:docs && pnpm docs:resources && pnpm --filter @orvui/docs dev",
    "brand:sync": "node tools/branding/sync.mjs",
    "build": "pnpm metadata:docs && pnpm build:lib && pnpm docs:resources && pnpm --filter @orvui/docs build",
    "build:lib": "pnpm theme:build && pnpm --filter @orvui/vue build",
    "typecheck": "pnpm typecheck:workspace && pnpm --filter @orvui/docs typecheck",
    "test": "vitest run",
    "registry:build": "tsx tools/registry/build.ts --strict",
    "api:check": "tsx tools/registry/audit-api.ts",
    "api:docs": "tsx tools/registry/component-docs.ts",
    "check": "pnpm metadata:docs && pnpm typecheck && pnpm api:check && pnpm test && pnpm build",
    "docs:generate": "pnpm metadata:docs && pnpm docs:resources",
    "docs:resources": "pnpm templates:build && tsx tools/registry/site-pages.ts && tsx tools/registry/markdown-pages.ts",
    "usage:docs": "tsx tools/registry/public-usage.ts",
    "metadata:docs": "pnpm brand:sync && pnpm theme:build && pnpm api:docs && pnpm registry:build && pnpm usage:docs",
    "theme:build": "tsx tools/theme/build.ts",
    "theme:check": "tsx tools/theme/build.ts --check",
    "package:build": "pnpm build:lib && pnpm registry:build",
    "verify:distribution": "node tools/verify-distribution.mjs",
    "verify:social": "node tools/verify-social.mjs",
    "verify:public-usage": "node tools/verify-public-usage.mjs",
    "verify:registry-usage": "node tools/verify-registry-usage.mjs",
    "typecheck:workspace": "vue-tsc --noEmit -p tsconfig.json",
    "docs:nuxt:dev": "pnpm dev",
    "docs:nuxt:build": "pnpm build",
    "docs:nuxt:preview": "pnpm preview",
    "docs:nuxt:start": "pnpm start",
    "verify:docs-nuxt": "tsx tools/docs/verify-nuxt.ts",
    "verify:docs-nuxt:browser": "PLAYWRIGHT_BROWSERS_PATH=artifacts/browsers playwright test --config tools/docs/playwright.config.ts",
    "docs:nuxt:browser:install": "PLAYWRIGHT_BROWSERS_PATH=artifacts/browsers playwright install chromium",
    "verify:docs-nuxt:standalone": "node tools/docs/verify-standalone.mjs",
    "preview": "pnpm --filter @orvui/docs preview",
    "start": "pnpm --filter @orvui/docs start",
    "verify:docs-netlify": "node tools/docs/verify-netlify.mjs",
    "templates:build": "tsx tools/docs/template-resources.ts",
    "verify:templates": "node tools/docs/verify-templates.mjs"
  },
  "devDependencies": {
    "@paper-design/shaders": "0.0.76",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/server-renderer": "^3.5.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.0",
    "lenis": "1.3.27",
    "lucide-vue-next": "0.468.0",
    "motion-v": "1.10.3",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0",
    "@playwright/test": "1.64.1"
  }
}
